<h1>Sign Up</h1>
<%= form_with model: @user do |f| %>
  <% if @user.errors.any? %>
    <div><%= @user.errors.full_messages.join(', ') %></div>
  <% end %>
  <%= f.text_field :email, placeholder: 'Email' %><br>
  <%= f.password_field :password, placeholder: 'Password (min 6 chars)' %><br>
  <%= f.password_field :password_confirmation, placeholder: 'Confirm Password' %><br>
  <%= f.submit 'Sign Up' %>
<% end %>
