<h1><%= @post.title %></h1>
<p><%= @post.content %></p>
<small>
  by <%= @post.user.email %>
  <% if @post.category %> in <%= @post.category.name %><% end %>
  | <%= @post.views_count %> views
  | <%= time_ago_in_words(@post.created_at) %> ago
  <% unless @post.published %> | <strong>DRAFT</strong><% end %>
</small>

<% if current_user == @post.user %>
  <%= link_to 'Edit', edit_post_path(@post) %>
  <%= button_to 'Delete', @post, method: :delete, data: { confirm: 'Are you sure?' } %>
<% end %>

<h3>Comments (<%= @post.comments.size %>)</h3>
<% @post.comments.each do |comment| %>
  <p>
    <%= comment.body %>
    <small>- <%= time_ago_in_words(comment.created_at) %> ago</small>
    <% if current_user == @post.user %>
      <%= button_to 'Delete', post_comment_path(@post, comment), method: :delete, data: { confirm: 'Sure?' } %>
    <% end %>
  </p>
<% end %>

<% if current_user %>
  <%= form_with model: [@post, @post.comments.build] do |f| %>
    <%= f.text_area :body, placeholder: 'Add a comment...' %>
    <%= f.submit 'Add Comment' %>
  <% end %>
<% end %>

<%= link_to 'Back', posts_path %>
